# Copy to .env if you want docker compose to pick these up.
# The stack boots without an LLM key. Generation then fails with a clear message.

# OpenCode Go (OpenAI-compatible chat completions). Default model is deepseek-v4.1-flash.
# DeepSeek on this endpoint needs the Global region enabled in the OpenCode workspace privacy settings.
# Other Go models: grok-4.7, glm-5.3-flash, grok-4.6, glm-5.3, deepseek-v4-pro.
OPENCODE_API_KEY=
LLM_API_KEY=
LLM_API_BASE=https://opencode.ai/zen/go/v1
# Same service, alternate host: https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash

# Native LiteLLM providers (OpenAI, Anthropic, Gemini, ...):
#   LLM_API_BASE=native
#   LLM_MODEL=openai/gpt-4o-mini
#   OPENAI_API_KEY=...
# Or keep an OpenAI-compatible base and set LLM_API_BASE=https://api.openai.com/v1
# with LLM_MODEL=gpt-4o-mini and LLM_API_KEY (or OPENAI_API_KEY).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional. Empty means the admin API is open on the private network.
ADMIN_TOKEN=

# auto uses Crawl4AI only when that extra is installed. The default image uses trafilatura.
CRAWL_BACKEND=auto

# Agent visibility diagnostics reject localhost/private IP literals by default.
DIAGNOSTICS_ALLOW_PRIVATE=false
